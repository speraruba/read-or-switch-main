{
  "name": "read-or-switch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate:part-names": "node --env-file=.env.local src/db/rename-study-parts.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:part-c-timing": "node --experimental-strip-types src/db/migrate.ts --part-c-timing",
    "db:migrate:part-c-recall": "node --experimental-strip-types src/db/migrate.ts --part-c-recall",
    "db:migrate:part-a-recall-phases": "node --experimental-strip-types src/db/migrate.ts --part-a-recall-phases",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:one": "node --experimental-strip-types --test",
    "db:migrate:production": "node src/db/upgrade-production.mjs",
    "db:migrate:participant-details": "node --experimental-strip-types src/db/migrate.ts --participant-details"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "mysql2": "^3.15.3",
    "next": "^15.1.11",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
