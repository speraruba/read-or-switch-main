DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=read-or-switch
DB_PORT=3306

# Railway: set MYSQL_URL to the MySQL service connection URL.
# When set, MYSQL_URL takes precedence over the DB_* variables.
MYSQL_URL=

# Server-only key for summary voice input. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
